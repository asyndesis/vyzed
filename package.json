{
  "name": "vyzed-next",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "auth generate --config src/server/auth.ts --output src/server/db/auth-schema.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/server/db/seed.ts",
    "gql": "tsx scripts/print-schema.ts && gql.tada generate-output",
    "postinstall": "paraglide-js compile --project ./src/i18n/project.inlang --outdir ./src/generated/paraglide",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run check:format && npm run lint && npm run check:names && npm run typecheck && npm run test && npm run check:generated",
    "check:generated": "npm run gql && npm run db:generate && git diff --exit-code -- src/generated src/server/db/migrations",
    "check:format": "oxfmt --check",
    "prepare": "husky",
    "check:names": "ls-lint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "^1.7.12",
    "@fontsource-variable/geist": "^5.3.0",
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-drizzle": "^0.20.0",
    "@pothos/plugin-scope-auth": "^4.2.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "gql.tada": "^1.11.4",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.6",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@electric-sql/pglite": "^0.5.10",
    "@inlang/paraglide-js": "^2.29.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "auth": "^1.7.12",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^1.0.0-rc.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
