{
  // Use the project's TypeScript so the gql.tada plugin loads (query autocomplete + errors)
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "files.watcherExclude": {
    "src/generated/**": true
  },
  "search.exclude": {
    "src/generated/**": true
  },
  "files.readonlyInclude": {
    "src/generated/**": true
  }
}
