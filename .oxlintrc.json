{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "react"],
  "jsPlugins": ["./scripts/oxlint-plugin.js"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "warn",
    "import/named": "error",
    "react/exhaustive-deps": "warn",
    "react/purity": "warn",
    "react/incompatible-library": "warn",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "gql.tada",
            "message": "Import GraphQL helpers from @/lib/gql."
          }
        ],
        "patterns": [
          {
            "group": ["./*", "../*"],
            "message": "Import with @/ paths."
          }
        ]
      }
    ],
    "vyzed/feature-boundaries": "error"
  },
  "ignorePatterns": ["src/generated/**", "src/server/db/migrations/**"],
  "overrides": [
    {
      "files": ["src/lib/gql.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
