{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "react"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "warn",
    "import/named": "error",
    "react/exhaustive-deps": "warn",
    "react/purity": "warn",
    "react/incompatible-library": "warn",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "gql.tada",
            "message": "Import GraphQL helpers from @/lib/gql."
          }
        ],
        "patterns": [
          {
            "group": ["./*", "../*"],
            "message": "Import with @/ paths (only features import their own files relatively)."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["src/generated/**", "src/server/db/migrations/**"],
  "overrides": [
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "gql.tada",
                "message": "Import GraphQL helpers from @/lib/gql."
              }
            ],
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "Features never import features via @/. Your own feature's files: use a relative path. Shared code: move to src/<kind>/."
              },
              {
                "group": ["../../**"],
                "message": "Don't leave your feature with a relative path. Move shared code to src/<kind>/ and import it with @/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/gql.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
