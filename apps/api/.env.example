PORT=4000
# Atlas connection string, including the database name
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/vyzed?retryWrites=true&w=majority
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL the browser uses for auth: the web app, which proxies /api to this server
BETTER_AUTH_URL=http://localhost:3000
# Public URL of the web app (CORS + trusted origin)
WEB_URL=http://localhost:3000
# Optional in dev (codes are printed to the console); required in production
RESEND_API_KEY=
EMAIL_FROM=Vyzed <login@example.com>
