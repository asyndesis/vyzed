// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id             String          @id @default(cuid())
    email          String          @unique
    firstName      String?
    lastName       String?
    imageUrl       String?
    roles          String[]        @default([])
    authId         String          @unique
    userProfile    UserProfile?
    studentProfile StudentProfile?
    teacherProfile TeacherProfile?
    taughtLessons  Lesson[]        @relation("TeacherLessons")
    enrollments    Enrollment[]    @relation("StudentEnrollments")
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    createdBy      String?
    updatedBy      String?
}

model UserProfile {
    id        String         @id @default(cuid())
    userId    String         @unique
    user      User           @relation(fields: [userId], references: [id])
    bio       String?
    languages UserLanguage[] @relation("UserProfileToLanguages")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    createdBy String?
    updatedBy String?
}

model StudentProfile {
    id        String         @id @default(cuid())
    userId    String         @unique
    user      User           @relation(fields: [userId], references: [id])
    skills    StudentSkill[] @relation("StudentProfileToSkills")
    createdAt DateTime       @default(now())
    updatedAt DateTime       @updatedAt
    createdBy String?
    updatedBy String?
}

model TeacherProfile {
    id            String         @id @default(cuid())
    userId        String         @unique
    user          User           @relation(fields: [userId], references: [id])
    skills        TeacherSkill[] @relation("TeacherProfileToSkills")
    priceAmount   Int            @default(0)
    priceCurrency String         @default("EUR")
    allowBarter   Boolean        @default(false)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    createdBy     String?
    updatedBy     String?
}

model UserLanguage {
    id            String      @id @default(cuid())
    userProfileId String
    userProfile   UserProfile @relation("UserProfileToLanguages", fields: [userProfileId], references: [id], onDelete: Cascade)
    skillId       String
    proficiency   Int
    skill         Skill       @relation(fields: [skillId], references: [id])
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    createdBy     String?
    updatedBy     String?
}

model StudentSkill {
    id               String         @id @default(cuid())
    studentProfileId String
    studentProfile   StudentProfile @relation("StudentProfileToSkills", fields: [studentProfileId], references: [id], onDelete: Cascade)
    skillId          String
    proficiency      Int
    skill            Skill          @relation(fields: [skillId], references: [id])
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    createdBy        String?
    updatedBy        String?
}

model TeacherSkill {
    id               String         @id @default(cuid())
    teacherProfileId String
    teacherProfile   TeacherProfile @relation("TeacherProfileToSkills", fields: [teacherProfileId], references: [id], onDelete: Cascade)
    skillId          String
    proficiency      Int
    skill            Skill          @relation(fields: [skillId], references: [id])
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    createdBy        String?
    updatedBy        String?
}

model Skill {
    id            String          @id @default(cuid())
    name          String
    parentId      String?
    parent        Skill?          @relation("SkillHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    children      Skill[]         @relation("SkillHierarchy")
    teacherSkills TeacherSkill[]
    studentSkills StudentSkill[]
    framework     SkillFramework?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    createdBy     String?
    updatedBy     String?
    UserLanguage  UserLanguage[]
    Lesson        Lesson[]
}

enum SkillFramework {
    CEFR
    DEFAULT
}

model MailingList {
    id        String   @id @default(cuid())
    email     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    createdBy String?
    updatedBy String?
}

enum LessonStatus {
    SCHEDULED
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum EnrollmentStatus {
    REQUESTED
    CONFIRMED
    REJECTED
    CANCELLED
}

enum PaymentType {
    CASH
    BARTER
    FREE
    CREDIT
}

model Lesson {
    id          String       @id @default(cuid())
    title       String
    description String?
    startTime   DateTime
    endTime     DateTime
    teacherId   String
    teacher     User         @relation("TeacherLessons", fields: [teacherId], references: [id])
    skillId     String
    skill       Skill        @relation(fields: [skillId], references: [id])
    proficiency Int
    maxStudents Int          @default(1)
    status      LessonStatus @default(SCHEDULED)
    enrollments Enrollment[] @relation("LessonEnrollments")
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    createdBy   String?
    updatedBy   String?
}

model Enrollment {
    id              String           @id @default(cuid())
    lessonId        String
    lesson          Lesson           @relation("LessonEnrollments", fields: [lessonId], references: [id], onDelete: Cascade)
    studentId       String
    student         User             @relation("StudentEnrollments", fields: [studentId], references: [id])
    paymentType     PaymentType      @default(CASH)
    paymentAmount   Int? // null if bartering
    paymentCurrency String? // null if bartering
    barterLessonId  String? // reference to a lesson the student provides in exchange
    status          EnrollmentStatus @default(REQUESTED)
    attended        Boolean          @default(false)
    feedback        String?
    rating          Int?
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    createdBy       String?
    updatedBy       String?

    @@unique([lessonId, studentId])
    @@index([status, lessonId])
}
