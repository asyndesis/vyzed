// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    email       String   @unique
    firstName   String?
    lastName    String?
    imageUrl    String?
    roles       String[] @default([])
    clerkUserId String   @unique
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    createdBy   String?
    updatedBy   String?
}

model SequenceBatch {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    createdBy String?
    updatedBy String?
}

model Sequence {
    id              String   @id @default(auto()) @map("_id") @db.ObjectId
    name            String?
    species         String?
    sequenceBatchId String?  @db.ObjectId
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    createdBy       String?
    updatedBy       String?
}
