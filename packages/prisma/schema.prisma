// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id             String          @id @default(cuid())
    email          String          @unique
    firstName      String?
    lastName       String?
    imageUrl       String?
    roles          String[]        @default([])
    authId         String          @unique
    userProfile    UserProfile?
    studentProfile StudentProfile?
    teacherProfile TeacherProfile?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    createdBy      String?
    updatedBy      String?
}

model UserProfile {
    id        String         @id @default(cuid())
    userId    String         @unique
    user      User           @relation(fields: [userId], references: [id])
    bio       String?
    languages UserLanguage[] @relation("UserProfileToLanguages")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    createdBy String?
    updatedBy String?
}

model StudentProfile {
    id        String         @id @default(cuid())
    userId    String         @unique
    user      User           @relation(fields: [userId], references: [id])
    skills    StudentSkill[] @relation("StudentProfileToSkills")
    createdAt DateTime       @default(now())
    updatedAt DateTime       @updatedAt
    createdBy String?
    updatedBy String?
}

model TeacherProfile {
    id        String         @id @default(cuid())
    userId    String         @unique
    user      User           @relation(fields: [userId], references: [id])
    skills    TeacherSkill[] @relation("TeacherProfileToSkills")
    createdAt DateTime       @default(now())
    updatedAt DateTime       @updatedAt
    createdBy String?
    updatedBy String?
}

model UserLanguage {
    id            String      @id @default(cuid())
    userProfileId String
    userProfile   UserProfile @relation("UserProfileToLanguages", fields: [userProfileId], references: [id], onDelete: Cascade)
    skillId       String
    proficiency   Int
    skill         Skill       @relation(fields: [skillId], references: [id])
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    createdBy     String?
    updatedBy     String?
}

model StudentSkill {
    id               String         @id @default(cuid())
    studentProfileId String
    studentProfile   StudentProfile @relation("StudentProfileToSkills", fields: [studentProfileId], references: [id], onDelete: Cascade)
    skillId          String
    proficiency      Int
    skill            Skill          @relation(fields: [skillId], references: [id])
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    createdBy        String?
    updatedBy        String?
}

model TeacherSkill {
    id               String         @id @default(cuid())
    teacherProfileId String
    teacherProfile   TeacherProfile @relation("TeacherProfileToSkills", fields: [teacherProfileId], references: [id], onDelete: Cascade)
    skillId          String
    proficiency      Int
    skill            Skill          @relation(fields: [skillId], references: [id])
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    createdBy        String?
    updatedBy        String?
}

model Skill {
    id            String          @id @default(cuid())
    name          String
    parentId      String?
    parent        Skill?          @relation("SkillHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    children      Skill[]         @relation("SkillHierarchy")
    teacherSkills TeacherSkill[]
    studentSkills StudentSkill[]
    framework     SkillFramework?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    createdBy     String?
    updatedBy     String?
    UserLanguage  UserLanguage[]
}

enum SkillFramework {
    CEFR
    DEFAULT
}
