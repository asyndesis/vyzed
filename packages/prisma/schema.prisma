// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    relationMode = "prisma"
    url      = env("DATABASE_URL")
}

model User {
    id                String          @id @default(auto()) @map("_id") @db.ObjectId
    email             String          @unique
    name              String          @default("")
    emailVerified     Boolean         @default(false)
    firstName         String?
    lastName          String?
    imageUrl          String?
    roles             String[]        @default(["user"])
    sessions          Session[]
    accounts          Account[]
    userProfile       UserProfile?
    studentProfile    StudentProfile?
    teacherProfile    TeacherProfile?
    taughtLessons     Lesson[]        @relation("TeacherLessons")
    enrollments       Enrollment[]    @relation("StudentEnrollments")
    taughtEnrollments Enrollment[]    @relation("TeacherEnrollments")
    userSchedule      UserSchedule?
    createdAt         DateTime        @default(now())
    updatedAt         DateTime        @updatedAt
    createdBy         String?
    updatedBy         String?
}

// Better Auth models
model Session {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @db.ObjectId
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    token     String   @unique
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

model Account {
    id                    String    @id @default(auto()) @map("_id") @db.ObjectId
    userId                String    @db.ObjectId
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
}

model Verification {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
}

model UserSchedule {
    id        String             @id @default(auto()) @map("_id") @db.ObjectId
    userId    String @db.ObjectId             @unique
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    slots     UserScheduleSlot[]
    createdAt DateTime           @default(now())
    updatedAt DateTime           @updatedAt
    createdBy String?
    updatedBy String?
}

model UserScheduleSlot {
    id             String               @id @default(auto()) @map("_id") @db.ObjectId
    userScheduleId String @db.ObjectId
    userSchedule   UserSchedule         @relation(fields: [userScheduleId], references: [id], onDelete: Cascade)
    dayOfWeek      DayOfWeek
    type           UserScheduleSlotType
    startTime      DateTime
    endTime        DateTime
    createdAt      DateTime             @default(now())
    updatedAt      DateTime             @updatedAt
    createdBy      String?
    updatedBy      String?
}

enum DayOfWeek {
    SUNDAY
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
}

enum UserScheduleSlotType {
    RECURRING_AVAILABLE
    SPECIFIC_AVAILABLE
    SPECIFIC_UNAVAILABLE
}

model UserProfile {
    id        String         @id @default(auto()) @map("_id") @db.ObjectId
    userId    String @db.ObjectId         @unique
    user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    bio       String?
    languages UserLanguage[] @relation("UserProfileToLanguages")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    createdBy String?
    updatedBy String?
}

model StudentProfile {
    id        String         @id @default(auto()) @map("_id") @db.ObjectId
    userId    String @db.ObjectId         @unique
    user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    skills    StudentSkill[] @relation("StudentProfileToSkills")
    createdAt DateTime       @default(now())
    updatedAt DateTime       @updatedAt
    createdBy String?
    updatedBy String?
}

model TeacherProfile {
    id            String         @id @default(auto()) @map("_id") @db.ObjectId
    userId        String @db.ObjectId         @unique
    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    skills        TeacherSkill[] @relation("TeacherProfileToSkills")
    priceAmount   Int            @default(0)
    priceCurrency String         @default("EUR")
    allowBarter   Boolean        @default(false)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    createdBy     String?
    updatedBy     String?
}

model UserLanguage {
    id            String      @id @default(auto()) @map("_id") @db.ObjectId
    userProfileId String @db.ObjectId
    userProfile   UserProfile @relation("UserProfileToLanguages", fields: [userProfileId], references: [id], onDelete: Cascade)
    skillId       String @db.ObjectId
    proficiency   Int
    skill         Skill       @relation(fields: [skillId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    createdBy     String?
    updatedBy     String?
}

model StudentSkill {
    id               String         @id @default(auto()) @map("_id") @db.ObjectId
    studentProfileId String @db.ObjectId
    studentProfile   StudentProfile @relation("StudentProfileToSkills", fields: [studentProfileId], references: [id], onDelete: Cascade)
    skillId          String @db.ObjectId
    proficiency      Int
    skill            Skill          @relation(fields: [skillId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    createdBy        String?
    updatedBy        String?
}

model TeacherSkill {
    id               String         @id @default(auto()) @map("_id") @db.ObjectId
    teacherProfileId String @db.ObjectId
    teacherProfile   TeacherProfile @relation("TeacherProfileToSkills", fields: [teacherProfileId], references: [id], onDelete: Cascade)
    skillId          String @db.ObjectId
    proficiency      Int
    skill            Skill          @relation(fields: [skillId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    createdBy        String?
    updatedBy        String?
}

model Skill {
    id            String          @id @default(auto()) @map("_id") @db.ObjectId
    name          String
    parentId      String? @db.ObjectId
    parent        Skill?          @relation("SkillHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    children      Skill[]         @relation("SkillHierarchy")
    teacherSkills TeacherSkill[]
    studentSkills StudentSkill[]
    framework     SkillFramework?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    createdBy     String?
    updatedBy     String?
    UserLanguage  UserLanguage[]
    Lesson        Lesson[]
}

enum SkillFramework {
    CEFR
    DEFAULT
}

model MailingList {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    email     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    createdBy String?
    updatedBy String?
}

enum LessonStatus {
    REQUESTED
    CONFIRMED
    CANCELLED
    COMPLETED
    REVISED
}

enum PaymentType {
    CASH
    BARTER
    FREE
    CREDIT
}

model Lesson {
    id          String       @id @default(auto()) @map("_id") @db.ObjectId
    startTime   DateTime
    endTime     DateTime
    teacherId   String @db.ObjectId
    teacher     User         @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)
    skillId     String @db.ObjectId
    skill       Skill        @relation(fields: [skillId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    proficiency Int
    maxStudents Int          @default(1)
    status      LessonStatus @default(REQUESTED)
    enrollments Enrollment[] @relation("LessonEnrollments")
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    createdBy   String?
    updatedBy   String?
}

model Enrollment {
    id               String       @id @default(auto()) @map("_id") @db.ObjectId
    lessonId         String @db.ObjectId
    lesson           Lesson       @relation("LessonEnrollments", fields: [lessonId], references: [id], onDelete: Cascade)
    studentId        String @db.ObjectId
    teacherId        String @db.ObjectId
    student          User         @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
    teacher          User         @relation("TeacherEnrollments", fields: [teacherId], references: [id], onDelete: Cascade)
    paymentType      PaymentType  @default(CASH)
    paymentAmount    Int? // null if bartering
    paymentCurrency  String? // null if bartering
    barterLessonId   String? @db.ObjectId // reference to a lesson the student provides in exchange
    status           LessonStatus @default(REQUESTED)
    teacherPaymentAt DateTime?
    studentPaymentAt DateTime?
    attended         Boolean      @default(false)
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt
    createdBy        String?
    updatedBy        String?

    @@unique([lessonId, studentId])
    @@index([status, lessonId])
}
