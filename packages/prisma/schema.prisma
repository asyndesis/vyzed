// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id                String          @id @default(cuid())
    email             String          @unique
    firstName         String?
    lastName          String?
    imageUrl          String?
    roles             String[]        @default([])
    authId            String          @unique
    userProfile       UserProfile?
    studentProfile    StudentProfile?
    teacherProfile    TeacherProfile?
    taughtLessons     Lesson[]        @relation("TeacherLessons")
    enrollments       Enrollment[]    @relation("StudentEnrollments")
    taughtEnrollments Enrollment[]    @relation("TeacherEnrollments")
    userSchedule      UserSchedule?
    createdAt         DateTime        @default(now())
    updatedAt         DateTime        @updatedAt
    createdBy         String?
    updatedBy         String?
}

model UserSchedule {
    id        String             @id @default(cuid())
    userId    String             @unique
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    slots     UserScheduleSlot[]
    createdAt DateTime           @default(now())
    updatedAt DateTime           @updatedAt
    createdBy String?
    updatedBy String?
}

model UserScheduleSlot {
    id             String               @id @default(cuid())
    userScheduleId String
    userSchedule   UserSchedule         @relation(fields: [userScheduleId], references: [id], onDelete: Cascade)
    dayOfWeek      Int?
    type           UserScheduleSlotType
    startTime      DateTime
    endTime        DateTime
    createdAt      DateTime             @default(now())
    updatedAt      DateTime             @updatedAt
    createdBy      String?
    updatedBy      String?
}

enum UserScheduleSlotType {
    RECURRING_AVAILABLE
    SPECIFIC_AVAILABLE
    SPECIFIC_UNAVAILABLE
}

model UserProfile {
    id        String         @id @default(cuid())
    userId    String         @unique
    user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    bio       String?
    languages UserLanguage[] @relation("UserProfileToLanguages")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    createdBy String?
    updatedBy String?
}

model StudentProfile {
    id        String         @id @default(cuid())
    userId    String         @unique
    user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    skills    StudentSkill[] @relation("StudentProfileToSkills")
    createdAt DateTime       @default(now())
    updatedAt DateTime       @updatedAt
    createdBy String?
    updatedBy String?
}

model TeacherProfile {
    id            String         @id @default(cuid())
    userId        String         @unique
    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    skills        TeacherSkill[] @relation("TeacherProfileToSkills")
    priceAmount   Int            @default(0)
    priceCurrency String         @default("EUR")
    allowBarter   Boolean        @default(false)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    createdBy     String?
    updatedBy     String?
}

model UserLanguage {
    id            String      @id @default(cuid())
    userProfileId String
    userProfile   UserProfile @relation("UserProfileToLanguages", fields: [userProfileId], references: [id], onDelete: Cascade)
    skillId       String
    proficiency   Int
    skill         Skill       @relation(fields: [skillId], references: [id])
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    createdBy     String?
    updatedBy     String?
}

model StudentSkill {
    id               String         @id @default(cuid())
    studentProfileId String
    studentProfile   StudentProfile @relation("StudentProfileToSkills", fields: [studentProfileId], references: [id], onDelete: Cascade)
    skillId          String
    proficiency      Int
    skill            Skill          @relation(fields: [skillId], references: [id])
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    createdBy        String?
    updatedBy        String?
}

model TeacherSkill {
    id               String         @id @default(cuid())
    teacherProfileId String
    teacherProfile   TeacherProfile @relation("TeacherProfileToSkills", fields: [teacherProfileId], references: [id], onDelete: Cascade)
    skillId          String
    proficiency      Int
    skill            Skill          @relation(fields: [skillId], references: [id])
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    createdBy        String?
    updatedBy        String?
}

model Skill {
    id            String          @id @default(cuid())
    name          String
    parentId      String?
    parent        Skill?          @relation("SkillHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    children      Skill[]         @relation("SkillHierarchy")
    teacherSkills TeacherSkill[]
    studentSkills StudentSkill[]
    framework     SkillFramework?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    createdBy     String?
    updatedBy     String?
    UserLanguage  UserLanguage[]
    Lesson        Lesson[]
}

enum SkillFramework {
    CEFR
    DEFAULT
}

model MailingList {
    id        String   @id @default(cuid())
    email     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    createdBy String?
    updatedBy String?
}

enum LessonStatus {
    REQUESTED
    CONFIRMED
    CANCELLED
    COMPLETED
    REVISED
}

enum PaymentType {
    CASH
    BARTER
    FREE
    CREDIT
}

model Lesson {
    id          String       @id @default(cuid())
    startTime   DateTime
    endTime     DateTime
    teacherId   String
    teacher     User         @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)
    skillId     String
    skill       Skill        @relation(fields: [skillId], references: [id])
    proficiency Int
    maxStudents Int          @default(1)
    status      LessonStatus @default(REQUESTED)
    enrollments Enrollment[] @relation("LessonEnrollments")
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    createdBy   String?
    updatedBy   String?
}

model Enrollment {
    id               String       @id @default(cuid())
    lessonId         String
    lesson           Lesson       @relation("LessonEnrollments", fields: [lessonId], references: [id], onDelete: Cascade)
    studentId        String
    teacherId        String
    student          User         @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
    teacher          User         @relation("TeacherEnrollments", fields: [teacherId], references: [id], onDelete: Cascade)
    paymentType      PaymentType  @default(CASH)
    paymentAmount    Int? // null if bartering
    paymentCurrency  String? // null if bartering
    barterLessonId   String? // reference to a lesson the student provides in exchange
    status           LessonStatus @default(REQUESTED)
    teacherPaymentAt DateTime?
    studentPaymentAt DateTime?
    attended         Boolean      @default(false)
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt
    createdBy        String?
    updatedBy        String?

    @@unique([lessonId, studentId])
    @@index([status, lessonId])
}
