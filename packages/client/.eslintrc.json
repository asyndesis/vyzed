{
  "root": true,
  "extends": ["eslint:recommended", "next", "next/core-web-vitals"],
  "plugins": [],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "import/no-unresolved": "error",
    "import/named": "error",
    "import/default": "error",
    "import/namespace": "error"
  },
  "ignorePatterns": ["node_modules/", "dist/", "build/"]
}
